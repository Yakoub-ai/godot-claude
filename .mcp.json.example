{
  "mcpServers": {
    "godot-mcp-pro": {
      "command": "node",
      "args": ["PATH_TO_GODOT_MCP_PRO/build/index.js"],
      "env": {
        "GODOT_MCP_PORT": "6505"
      }
    },
    "pixellab": {
      "type": "http",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_PIXELLAB_API_KEY"
      }
    }
  }
}
